diff --git a/apps/overlay/src-tauri/Cargo.toml b/apps/overlay/src-tauri/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..c6c82efda3bbf2e475cbe0ddc6909b845e3cfd8c
--- /dev/null
+++ b/apps/overlay/src-tauri/Cargo.toml
@@ -0,0 +1,32 @@
+[package]
+name = "notify-overlay"
+version = "0.1.0"
+edition = "2021"
+license = "MIT"
+
+[build-dependencies]
+tauri-build = { version = "2", features = [] }
+
+[dependencies]
+tauri = { version = "2", features = ["tray-icon"] }
+serde = { version = "1", features = ["derive"] }
+serde_json = "1"
+tauri-plugin-global-shortcut = "2"
+tauri-plugin-clipboard-manager = "2"
+
+[target.'cfg(windows)'.dependencies]
+# Win32 calls for capturing the selected text in other apps (src/selection.rs).
+windows-sys = { version = "0.59", features = [
+    "Win32_Foundation",
+    "Win32_System_DataExchange",
+    "Win32_System_Diagnostics_Debug",
+    "Win32_System_Threading",
+    "Win32_UI_Input_KeyboardAndMouse",
+    "Win32_UI_WindowsAndMessaging",
+] }
+
+[profile.release]
+opt-level = "s"
+lto = true
+codegen-units = 1
+strip = true
diff --git a/apps/overlay/src-tauri/build.rs b/apps/overlay/src-tauri/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d860e1e6a7cac333c3cc0bc9cb67faf286b07d69
--- /dev/null
+++ b/apps/overlay/src-tauri/build.rs
@@ -0,0 +1,3 @@
+fn main() {
+    tauri_build::build()
+}
diff --git a/apps/overlay/src-tauri/capabilities/default.json b/apps/overlay/src-tauri/capabilities/default.json
new file mode 100644
index 0000000000000000000000000000000000000000..5c4aaed372928d9164ba1922940f39d35f08c63a
--- /dev/null
+++ b/apps/overlay/src-tauri/capabilities/default.json
@@ -0,0 +1,11 @@
+{
+  "$schema": "../gen/schemas/desktop-schema.json",
+  "identifier": "default",
+  "description": "Permissions for the overlay window",
+  "windows": ["overlay"],
+  "permissions": [
+    "core:default",
+    "core:window:allow-start-dragging",
+    "core:window:allow-start-resize-dragging"
+  ]
+}
