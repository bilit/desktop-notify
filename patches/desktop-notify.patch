diff --git a/apps/overlay/src/notify/BulkButtons.jsx b/apps/overlay/src/notify/BulkButtons.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..71b6ced2fb023f923df112fd962fa0e5c9f903db
--- /dev/null
+++ b/apps/overlay/src/notify/BulkButtons.jsx
@@ -0,0 +1,46 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { CONFIRM_MS } from './shared.js';
+
+/**
+ * Bulk actions for a group of same-kind notifications, as declared by the kind's view:
+ * `view.bulk` = [{action, label, style, confirm?}]. A `confirm` action needs a second click within 3s.
+ * Whole-group actions are risky for some kinds (e.g. approving payments) and harmless for others (dismissing), which
+ * is why each kind's view declares which ones need the confirming click. `style` is a button class: primary, info,
+ * neutral or warn.
+ */
+export default function BulkButtons({ items, act, view }) {
+  const [confirming, setConfirming] = useState(null); // action awaiting a second click
+  const timer = useRef(null);
+  const ids = items.map((x) => x.id);
+
+  // A changed set invalidates a pending confirmation: the user hasn't seen the new set.
+  const key = ids.join('|');
+  useEffect(() => { setConfirming(null); clearTimeout(timer.current); }, [key]);
+  useEffect(() => () => clearTimeout(timer.current), []);
+
+  const run = (b) => {
+    if (b.confirm && confirming !== b.action) {
+      setConfirming(b.action);
+      clearTimeout(timer.current);
+      timer.current = setTimeout(() => setConfirming(null), CONFIRM_MS);
+      return;
+    }
+    clearTimeout(timer.current);
+    setConfirming(null);
+    act(ids, b.action);
+  };
+
+  return (
+    <div className="bulk">
+      <span className="bulk-label mono">{items.length} {items.length === 1 ? view.noun : `${view.noun}s`}</span>
+      {view.bulk.map((b) => {
+        const armed = confirming === b.action;
+        return (
+          <button key={b.action} className={armed ? 'warn' : b.style} onClick={() => run(b)}>
+            {armed ? `Confirm ${items.length}?` : b.label}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
diff --git a/apps/overlay/src/notify/CardShell.jsx b/apps/overlay/src/notify/CardShell.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..12bdee0c9965fb9a4c9271e13adcc07f924f032e
--- /dev/null
+++ b/apps/overlay/src/notify/CardShell.jsx
@@ -0,0 +1,31 @@
+import React from 'react';
+
+const FRESH_MS = 1500; // how long a new arrival is highlighted
+
+/**
+ * Wraps one notification's card with the behaviour every kind gets for free:
+ *  - a × that HIDES the card on this overlay. It sends no action: the notification stays live for everyone else
+ *    (browser, other devices) and expires normally. Closing must never secretly mean "decline" or "reject".
+ *  - click anywhere on the card except its own buttons to open it in the app window, when one is configured
+ *  - a brief highlight when it has just arrived
+ * Views only draw the card; they don't need to know about any of this.
+ */
+export default function CardShell({ n, view, act, onOpen, onHide }) {
+  const fresh = Date.now() - n.arrivedAt < FRESH_MS;
+  return (
+    <div
+      className={`shell ${fresh ? 'fresh' : ''} ${onOpen ? 'openable' : ''}`}
+      onClick={onOpen ? (e) => onOpen(n, e) : undefined}
+    >
+      <view.Card n={n} act={act} />
+      <button
+        className="close"
+        aria-label="Hide notification"
+        title="Hide (it stays live elsewhere; no action is sent)"
+        onClick={() => onHide([n.id])}
+      >
+        ×
+      </button>
+    </div>
+  );
+}
diff --git a/apps/overlay/src/notify/Overlay.jsx b/apps/overlay/src/notify/Overlay.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..4696d737a7dd317fc6c1b07c7a7600ddccb1e524
--- /dev/null
+++ b/apps/overlay/src/notify/Overlay.jsx
@@ -0,0 +1,197 @@
+import React, { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react';
+import { listen } from '@tauri-apps/api/event';
+import { invoke } from '@tauri-apps/api/core';
+import CardShell from './CardShell.jsx';
+import Panel from './Panel.jsx';
+import { defaultView } from './defaultView.jsx';
+
+const HUB_WS = import.meta.env.VITE_HUB_WS ?? 'ws://127.0.0.1:4000/ws';
+const TOKEN = import.meta.env.VITE_NOTIFY_TOKEN ?? 'local_dev_handshake_token'; // dev token; real auth is a later step
+const WIDTH = 380;
+// Hybrid layout: 1-2 notifications are compact cards; a burst switches to the resizable panel.
+// Enter at 3, leave only at 1 or fewer, so the window doesn't flap while a burst is being worked down.
+const PANEL_ENTER = 3;
+const PANEL_EXIT = 1;
+const GEOMETRY_KEY = 'overlay.panelGeometry';
+// After a NEW notification the window stays on top this long, so clicking another app right away can't bury it;
+// then it drops back to a normal window. 0 = raise once and don't hold.
+const RAISE_HOLD_MS = 5000;
+
+// A notification can restrict which clients show it; no list means every desktop overlay shows it.
+const forDesktop = (n) => !n.surfaces || n.surfaces.includes('desktop');
+
+const stamp = (n) => ({ ...n, expiresAt: Date.now() + (n.ttlSeconds ?? 30) * 1000, arrivedAt: Date.now() });
+
+const loadGeometry = () => {
+  try { return JSON.parse(localStorage.getItem(GEOMETRY_KEY)) ?? null; } catch { return null; }
+};
+
+/**
+ * The overlay shell: hub connection, hybrid cards/panel layout, window fitting. It knows nothing about any
+ * notification kind. `views` maps kind -> {Card, noun, subtitle?(items), bulk[]}; unknown kinds use defaultView.
+ */
+export default function Overlay({ views = {} }) {
+  const [items, setItems] = useState([]); // oldest -> newest; each is a hub notification + expiresAt/arrivedAt
+  const [, setTick] = useState(0);
+  const [arrivals, setArrivals] = useState(0); // bumps on each NEW notification (not updates/resolutions)
+  const [appConfigured, setAppConfigured] = useState(false); // is there an app window to open? (NOTIFY_APP_URL)
+  // Ids the user closed (×) on this overlay. Hiding is local only: nothing is sent, and the notification stays live
+  // for everyone else and expires normally. A left-click on the tray icon brings them back.
+  const [hidden, setHidden] = useState(() => new Set());
+  const hiddenSize = useRef(0);
+  hiddenSize.current = hidden.size;
+  const wsRef = useRef(null);
+  const stackRef = useRef(null);
+
+  const visible = items.filter((n) => !hidden.has(n.id));
+
+  // Pure function of the previous mode and the count, so re-renders can't change the result.
+  const panelRef = useRef(false);
+  panelRef.current = panelRef.current ? visible.length > PANEL_EXIT : visible.length >= PANEL_ENTER;
+  const panel = panelRef.current;
+
+  const hide = useCallback((ids) => setHidden((prev) => new Set([...prev, ...ids])), []);
+
+  // Forget hidden ids once their notification is gone (resolved, expired, or the connection dropped), so the set
+  // can't grow without bound.
+  useEffect(() => {
+    setHidden((prev) => {
+      if (prev.size === 0) return prev;
+      const live = new Set(items.map((n) => n.id));
+      const next = new Set([...prev].filter((id) => live.has(id)));
+      return next.size === prev.size ? prev : next;
+    });
+  }, [items]);
+
+  // --- Hub connection (the overlay is just another client, role "desktop") ---
+  useEffect(() => {
+    let stopped = false;
+    let retry;
+    let user = null; // NOTIFY_USER, else the Windows user name (see overlay_identity in main.rs)
+
+    const connect = () => {
+      if (stopped) return;
+      // `user` is a claim, not a login: it says whose notifications we want, and the server decides whether to believe it.
+      const query = new URLSearchParams({ role: 'desktop', token: TOKEN });
+      if (user) query.set('user', user);
+      const ws = new WebSocket(`${HUB_WS}?${query}`);
+      wsRef.current = ws;
+
+      ws.onmessage = (e) => {
+        let m;
+        try { m = JSON.parse(e.data); } catch { return; }
+        if (m.type === 'SNAPSHOT') setItems(m.notifications.filter(forDesktop).map(stamp));
+        else if (m.type === 'NOTIFY') {
+          if (!forDesktop(m.notification)) return; // e.g. clipboard text is for the browser, not for us
+          setItems((p) => [...p.filter((x) => x.id !== m.notification.id), stamp(m.notification)]);
+          setArrivals((a) => a + 1);
+        }
+        else if (m.type === 'UPDATE') {
+          // Update in place; keep the original expiry (the hub's TTL keeps running).
+          setItems((p) => p.map((x) => (x.id === m.notification.id ? { ...x, ...m.notification, expiresAt: x.expiresAt } : x)));
+        } else if (m.type === 'RESOLVED') setItems((p) => p.filter((x) => x.id !== m.id));
+      };
+      ws.onclose = () => {
+        wsRef.current = null;
+        setItems([]); // can't act while disconnected; the SNAPSHOT on reconnect restores what's live
+        if (!stopped) retry = setTimeout(connect, 3000);
+      };
+      ws.onerror = () => ws.close();
+    };
+    // Ask for the name once, then connect; if it can't be read we still connect, just without a claim.
+    invoke('overlay_identity').then((u) => { user = u; }).catch(() => {}).finally(connect);
+
+    return () => { stopped = true; clearTimeout(retry); wsRef.current?.close(); };
+  }, []);
+
+  const act = useCallback((ids, action, payload) => {
+    const ws = wsRef.current;
+    if (!ws || ws.readyState !== WebSocket.OPEN) return;
+    // Items leave when the hub confirms with RESOLVED, so every surface stays in sync.
+    ids.forEach((id) => ws.send(JSON.stringify({ type: 'ACTION', id, action, payload })));
+  }, []);
+
+  useEffect(() => { invoke('app_configured').then(setAppConfigured).catch(() => {}); }, []);
+
+  // Clicking a card (anywhere except its own buttons) opens the app window and tells the page which notification it
+  // was. The page gets a plain browser event, never access to native commands; `open` is whatever target the
+  // publisher attached, interpreted by the page.
+  const open = useCallback((n, e) => {
+    if (e.target.closest('button')) return;
+    invoke('open_in_app', { notification: { id: n.id, kind: n.kind, data: n.data, open: n.open } }).catch(() => {});
+  }, []);
+
+  // --- Tray icon left-click: bring back anything the user closed (×) ---
+  useEffect(() => {
+    const un = listen('tray-action', (e) => {
+      if (e.payload !== 'unhide' || hiddenSize.current === 0) return;
+      setHidden(new Set());
+      setArrivals((a) => a + 1); // shows and raises the window like a new arrival
+    });
+    return () => { un.then((f) => f()); };
+  }, []);
+
+  // --- Global hotkey (handled in Rust): it read the clipboard; forward the text to the hub, which shows it in the browser ---
+  useEffect(() => {
+    const un = listen('clipboard-send', (e) => {
+      const ws = wsRef.current;
+      if (ws?.readyState === WebSocket.OPEN && typeof e.payload === 'string') {
+        ws.send(JSON.stringify({ type: 'CLIPBOARD', text: e.payload }));
+      }
+    });
+    return () => { un.then((f) => f()); };
+  }, []);
+
+  // Re-render a few times a second so countdowns move and "fresh" highlights expire.
+  useEffect(() => {
+    const t = setInterval(() => setTick((v) => v + 1), 250);
+    return () => clearInterval(t);
+  }, []);
+
+  // --- Window mode: tell Rust when we enter/leave panel mode, and remember where the user puts the panel ---
+  useEffect(() => {
+    invoke('set_panel_mode', { active: panel, geometry: panel ? loadGeometry() : null });
+  }, [panel]);
+
+  useEffect(() => {
+    let timer;
+    const un = listen('overlay-geometry', (e) => {
+      clearTimeout(timer); // moving/resizing fires many events; save once it settles
+      timer = setTimeout(() => {
+        try { localStorage.setItem(GEOMETRY_KEY, JSON.stringify(e.payload)); } catch { /* storage unavailable */ }
+      }, 300);
+    });
+    return () => { clearTimeout(timer); un.then((f) => f()); };
+  }, []);
+
+  // --- New notification: jump above everything and hold there briefly, then behave like a normal window.
+  // Runs after the layout effect below has sized and shown the window, so there is something to raise.
+  useEffect(() => {
+    if (arrivals > 0) invoke('raise_overlay', { holdMs: RAISE_HOLD_MS });
+  }, [arrivals]);
+
+  // --- Cards mode: the window hugs its content. Panel mode: the user owns the size. ---
+  useLayoutEffect(() => {
+    if (panel) return;
+    const el = stackRef.current;
+    if (!el) { invoke('fit_overlay', { width: WIDTH, height: 0 }); return; } // nothing live: hide
+    const fit = () => invoke('fit_overlay', { width: WIDTH, height: Math.ceil(el.getBoundingClientRect().height) });
+    fit();
+    const ro = new ResizeObserver(fit);
+    ro.observe(el);
+    return () => ro.disconnect();
+  });
+
+  if (visible.length === 0) return null;
+
+  const onOpen = appConfigured ? open : null;
+  if (panel) return <Panel items={visible} views={views} act={act} onOpen={onOpen} onHide={hide} />;
+
+  return (
+    <div id="stack" ref={stackRef}>
+      {visible.map((n) => (
+        <CardShell key={n.id} n={n} view={views[n.kind] ?? defaultView} act={act} onOpen={onOpen} onHide={hide} />
+      ))}
+    </div>
+  );
+}
diff --git a/apps/overlay/src/notify/Panel.jsx b/apps/overlay/src/notify/Panel.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..2cecfc7e51d202a06b5bff857758463a31a67154
--- /dev/null
+++ b/apps/overlay/src/notify/Panel.jsx
@@ -0,0 +1,80 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { getCurrentWindow } from '@tauri-apps/api/window';
+import BulkButtons from './BulkButtons.jsx';
+import CardShell from './CardShell.jsx';
+import { defaultView } from './defaultView.jsx';
+import { secondsLeft } from './shared.js';
+
+const AT_TOP_PX = 40;  // within this of the top counts as "looking at the newest"
+
+/**
+ * Panel mode (3+ live notifications): one draggable, resizable window.
+ *  - header: summary + bulk actions per kind (drag the header to move the window)
+ *  - list: every live notification as its kind's card, newest on top, scrollable
+ *  - "N new" chip when something arrives while you're scrolled down
+ *  - grip in the bottom-right corner to resize
+ */
+export default function Panel({ items, views, act, onOpen, onHide }) {
+  const listRef = useRef(null);
+  const [atTop, setAtTop] = useState(true);
+  const seen = useRef(new Set()); // ids the user has had the chance to see (they were at the top)
+
+  // While at the top, everything live counts as seen; otherwise new ids accumulate as "new".
+  useEffect(() => {
+    if (atTop) items.forEach((n) => seen.current.add(n.id));
+  });
+  const unseen = atTop ? 0 : items.filter((n) => !seen.current.has(n.id)).length;
+
+  const ordered = [...items].reverse(); // newest first
+  const viewOf = (kind) => views[kind] ?? defaultView;
+
+  // One bulk group per kind so a bulk action only ever touches notifications of the same type.
+  const groups = new Map();
+  items.forEach((n) => groups.set(n.kind, [...(groups.get(n.kind) ?? []), n]));
+
+  const soonest = Math.max(0, Math.ceil(Math.min(...items.map(secondsLeft))));
+  const breakdown = [...groups].map(([kind, g]) => viewOf(kind).subtitle?.(g)).filter(Boolean).join(' • ');
+  const oneKind = groups.size === 1 ? viewOf([...groups.keys()][0]) : null;
+  const title = oneKind ? `${items.length} ${items.length === 1 ? oneKind.noun : `${oneKind.noun}s`}` : `${items.length} notifications`;
+
+  return (
+    <div id="panel">
+      <div className="panel-head" data-tauri-drag-region>
+        <button
+          className="panel-close"
+          aria-label="Hide all notifications"
+          title="Hide all (they stay live elsewhere; no action is sent). Left-click the tray icon to bring them back."
+          onClick={() => onHide(items.map((n) => n.id))}
+        >
+          ×
+        </button>
+        <div className="panel-title">
+          <h2 className="mono">{title}</h2>
+          <div className="sub">{breakdown ? `${breakdown} • ` : ''}soonest expires in {soonest}s</div>
+        </div>
+        <div className="bulks">
+          {[...groups].map(([kind, g]) => <BulkButtons key={kind} items={g} act={act} view={viewOf(kind)} />)}
+        </div>
+      </div>
+
+      <div className="plist-wrap">
+        {unseen > 0 && (
+          <button className="new-chip" onClick={() => listRef.current?.scrollTo({ top: 0, behavior: 'smooth' })}>
+            ▲ {unseen} new
+          </button>
+        )}
+        <div className="plist" ref={listRef} onScroll={(e) => setAtTop(e.currentTarget.scrollTop < AT_TOP_PX)}>
+          {ordered.map((n) => (
+            <CardShell key={n.id} n={n} view={viewOf(n.kind)} act={act} onOpen={onOpen} onHide={onHide} />
+          ))}
+        </div>
+      </div>
+
+      <div
+        className="grip"
+        title="Drag to resize"
+        onMouseDown={(e) => { e.preventDefault(); getCurrentWindow().startResizeDragging('SouthEast'); }}
+      />
+    </div>
+  );
+}
diff --git a/apps/overlay/src/notify/defaultView.jsx b/apps/overlay/src/notify/defaultView.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..0832cd4963266f8fed7644768520c2c358a2f57f
--- /dev/null
+++ b/apps/overlay/src/notify/defaultView.jsx
@@ -0,0 +1,27 @@
+import React from 'react';
+import { secondsLeft } from './shared.js';
+
+// Fallback view for any notification `kind` that has no registered view.
+// Expects `data: { title?, text? }`; offers a single "dismiss" action.
+
+function Card({ n, act }) {
+  const d = n.data ?? {};
+  return (
+    <div className="card">
+      <div className="row">
+        <span className="title mono">{d.title ?? n.kind}</span>
+        <span className="meta mono">{Math.ceil(secondsLeft(n))}s</span>
+      </div>
+      {d.text && <div className="text" style={{ margin: '8px 0' }}>{d.text}</div>}
+      <div className="btns two" style={{ marginTop: 8 }}>
+        <button className="neutral" onClick={() => act([n.id], 'dismiss')}>Dismiss</button>
+      </div>
+    </div>
+  );
+}
+
+export const defaultView = {
+  Card,
+  noun: 'notification',
+  bulk: [{ action: 'dismiss', label: 'Dismiss all', style: 'neutral' }],
+};
diff --git a/apps/overlay/src/notify/shared.js b/apps/overlay/src/notify/shared.js
