diff --git a/packages/server/server.js b/packages/server/server.js
new file mode 100644
index 0000000000000000000000000000000000000000..f98733cb1ca7ebd8c2c37873c61397b7c9c4e415
--- /dev/null
+++ b/packages/server/server.js
@@ -0,0 +1,149 @@
+// Standalone notification hub: the embeddable module (src/createNotifyServer.js) plus the HTTP bits a stand-alone
+// process needs, for publishers that can't call the module in-process.
+//
+//  - GET  /health
+//  - POST /publish   (Authorization: Bearer <token>)  publish { kind, id?, ttlSeconds?, data? }
+//  - plugin routes   (see below)
+//  - WebSocket at /ws
+//
+// This mode has ONE user ("local") and ONE shared token. It is for development and single-user setups. To serve
+// real users, embed the module in your own backend instead (see README): you supply `authenticate`, and every
+// notification is delivered to just that user's clients.
+
+import http from 'node:http';
+import path from 'node:path';
+import { timingSafeEqual } from 'node:crypto';
+import { pathToFileURL } from 'node:url';
+import { createNotifyServer } from './index.js';
+
+const PORT = Number(process.env.PORT ?? 4000);
+const HOST = process.env.HOST || '127.0.0.1'; // loopback by default
+// The default token is published in this repo's source and README, so it is only acceptable while the hub is reachable
+// from this machine alone. An empty NOTIFY_TOKEN counts as unset (an empty token would let anyone in).
+const DEFAULT_TOKEN = 'local_dev_handshake_token';
+const TOKEN = process.env.NOTIFY_TOKEN || DEFAULT_TOKEN;
+const loopback = HOST === 'localhost' || HOST === '::1' || HOST.startsWith('127.');
+if (!loopback && (TOKEN === DEFAULT_TOKEN || TOKEN.length < 16)) {
+  console.error(
+    `Refusing to listen on ${HOST}: the hub would be reachable from the network with a ${
+      TOKEN === DEFAULT_TOKEN ? 'built-in, publicly known' : 'too short'
+    } token.\nSet NOTIFY_TOKEN to a long random value (16+ characters), or keep HOST on 127.0.0.1.`
+  );
+  process.exit(1);
+}
+const ALLOWED_ORIGINS = (
+  process.env.ALLOWED_ORIGINS ??
+  // web app (dev), then the Tauri webview (dev server, and packaged build on Windows)
+  'http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost'
+).split(',');
+const MAX_BODY_BYTES = 64 * 1024;
+const LOCAL_USER = 'local';
+
+function tokenOk(supplied) {
+  const a = Buffer.from(String(supplied ?? ''));
+  const b = Buffer.from(TOKEN);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+function originAllowed(req) {
+  const origin = req.headers.origin;
+  return origin === undefined || ALLOWED_ORIGINS.includes(origin); // non-browser callers send no Origin
+}
+
+function readJson(req) {
+  return new Promise((resolveBody, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > MAX_BODY_BYTES) { reject(new Error('too large')); req.destroy(); return; }
+      chunks.push(c);
+    });
+    req.on('end', () => {
+      try { resolveBody(JSON.parse(Buffer.concat(chunks).toString() || 'null')); } catch (e) { reject(e); }
+    });
+    req.on('error', reject);
+  });
+}
+
+// ---------------------------------------------------------------- plugins
+//
+// The hub knows nothing about any kind of notification. A plugin adds HTTP routes, typically a feed that publishes
+// into the hub (for example, a feed that publishes sample data). A plugin is an ES module whose default export is
+//
+//     (hub) => async (req, res, { json }) => handled      // return true if it served the request
+//
+// where `hub` is { publish(notification), liveIds() }. Load plugins with `--plugin <path>` (repeatable) or the
+// NOTIFY_PLUGINS environment variable (comma-separated). Paths are relative to the working directory.
+// Plugin routes run after the Origin check but are NOT token-protected: plugins are trusted, local code.
+
+const server = http.createServer(async (req, res) => {
+  const origin = req.headers.origin;
+  if (!originAllowed(req)) return void res.writeHead(403).end('origin not allowed');
+  if (origin) {
+    res.setHeader('Access-Control-Allow-Origin', origin);
+    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+    res.setHeader('Access-Control-Allow-Headers', 'content-type, authorization');
+    res.setHeader('Vary', 'Origin');
+  }
+  if (req.method === 'OPTIONS') return void res.writeHead(204).end();
+
+  const json = (code, body) => res.writeHead(code, { 'content-type': 'application/json' }).end(JSON.stringify(body));
+
+  if (req.method === 'GET' && req.url === '/health') {
+    const s = notify.stats();
+    return json(200, { ok: true, live: s.live, clients: s.clients, desktopConnected: notify.desktopConnected(LOCAL_USER) });
+  }
+
+  // Generic ingest: any system can POST a notification here. Requires the bearer token.
+  if (req.method === 'POST' && req.url === '/publish') {
+    if (!tokenOk(req.headers.authorization?.replace(/^Bearer /, ''))) return json(401, { error: 'unauthorized' });
+    try {
+      const body = await readJson(req);
+      if (!body || typeof body !== 'object' || typeof body.kind !== 'string' || !body.kind) {
+        return json(400, { error: 'body must be an object with a string "kind"' });
+      }
+      return json(200, notify.publish(LOCAL_USER, body));
+    } catch (err) {
+      return json(400, { error: err instanceof TypeError ? err.message : 'invalid json' });
+    }
+  }
+
+  for (const handle of pluginHandlers) {
+    if (await handle(req, res, { json })) return;
+  }
+
+  json(404, { error: 'not found' });
+});
+
+const queryToken = (req) => new URL(req.url ?? '/', 'http://localhost').searchParams.get('token');
+
+const notify = createNotifyServer({
+  server,
+  path: '/ws',
+  // Single shared token for both kinds of client, as before.
+  authenticate: (req) => (tokenOk(queryToken(req)) ? LOCAL_USER : null),
+  authenticateDesktop: (token) => (tokenOk(token) ? LOCAL_USER : null),
+  allowedOrigins: ALLOWED_ORIGINS,
+  desktopOrigins: ALLOWED_ORIGINS,
+});
+notify.on('connect', ({ role }) => console.log(`+ ${role} connected (${notify.stats().clients} clients)`));
+notify.on('disconnect', ({ role }) => console.log(`- ${role} disconnected (${notify.stats().clients} clients)`));
+
+const pluginPaths = [
+  ...process.argv.flatMap((arg, i, all) => (arg === '--plugin' && all[i + 1] ? [all[i + 1]] : [])),
+  ...(process.env.NOTIFY_PLUGINS ?? '').split(',').map((p) => p.trim()).filter(Boolean),
+];
+const pluginHandlers = [];
+for (const p of pluginPaths) {
+  const mod = await import(pathToFileURL(path.resolve(p)).href);
+  if (typeof mod.default !== 'function') throw new Error(`plugin ${p} must default-export (hub) => handler`);
+  pluginHandlers.push(
+    mod.default({ publish: (n) => notify.publish(LOCAL_USER, n), liveIds: () => notify.liveIds(LOCAL_USER) })
+  );
+  console.log(`plugin loaded: ${p}`);
+}
+
+server.listen(PORT, HOST, () => {
+  console.log(`Notification hub on http://${HOST}:${PORT} (ws path /ws, ${pluginHandlers.length} plugin${pluginHandlers.length === 1 ? '' : 's'})`);
+});
diff --git a/packages/server/src/createNotifyServer.js b/packages/server/src/createNotifyServer.js
new file mode 100644
index 0000000000000000000000000000000000000000..e964b73c3f2b2b276e207216a269347b64a9beaf
--- /dev/null
+++ b/packages/server/src/createNotifyServer.js
@@ -0,0 +1,307 @@
+import { EventEmitter } from 'node:events';
+import { WebSocketServer } from 'ws';
+import { createDeviceTokens } from './deviceToken.js';
+
+// Embeddable notification server. Attach it to the HTTP server your backend already runs:
+//
+//   const notify = createNotifyServer({
+//     server,                                        // your http.Server
+//     path: '/notify',
+//     authenticate: (req) => req.session?.userId,    // who is this browser connection? (null = reject)
+//     secret: process.env.NOTIFY_SECRET,             // enables device tokens for the desktop overlay
+//   });
+//   notify.publish(userId, { kind: 'order-filled', ttlSeconds: 30, data: { ... } });
+//   notify.on('action', ({ userId, id, action, payload }) => { ... });
+//
+// It owns live notification state per user (TTL expiry, first action wins) and fans each notification out to that
+// user's connected clients only: their browser tabs and their desktop overlay. It knows nothing about any kind.
+//
+// Wire messages (plain JSON):
+//   server -> client:  NOTIFY {notification} | UPDATE {notification} | RESOLVED {id, kind, action, payload, by}
+//                      SNAPSHOT {notifications} | PRESENCE {desktopConnected}
+//   client -> server:  ACTION {id, action, payload?}
+//                      CLIPBOARD {text}   (desktop role only; becomes a browser-only "clipboard" notification)
+
+const ACTION_RE = /^[A-Za-z0-9_-]{1,32}$/;
+const KIND_RE = /^[A-Za-z0-9._:-]{1,64}$/;
+const ROLES = new Set(['browser', 'desktop']);
+const DEFAULT_DESKTOP_ORIGINS = ['http://tauri.localhost', 'https://tauri.localhost', 'http://localhost:1420'];
+const DEFAULT_DEVICE_TOKEN_TTL_SECONDS = 7 * 24 * 60 * 60; // tokens can't be revoked individually, so keep them short
+
+export function createNotifyServer(options = {}) {
+  const {
+    server,
+    path = '/notify',
+    authenticate,
+    authenticateDesktop,
+    secret,
+    allowedOrigins,
+    desktopOrigins = DEFAULT_DESKTOP_ORIGINS,
+    maxPayload = 64 * 1024,
+    maxLivePerUser = 1000,
+    maxClipboardChars = 5000,
+    heartbeatMs = 20_000,
+    logger = console,
+  } = options;
+
+  if (!server || typeof server.on !== 'function') throw new TypeError('notify-server: `server` (an http.Server) is required');
+  if (typeof authenticate !== 'function') throw new TypeError('notify-server: `authenticate(req)` is required');
+  const tokens = secret ? createDeviceTokens(secret) : null;
+
+  const events = new EventEmitter();
+  /** userId -> { live: Map<id, {n, expiresAt, timer}>, clients: Set<{ws, role, alive}> } */
+  const users = new Map();
+  let nextId = 1000;
+
+  // ------------------------------------------------------------------ helpers
+
+  const normalizeUserId = (userId) => {
+    if (userId === null || userId === undefined || String(userId) === '') {
+      throw new TypeError('notify-server: userId is required');
+    }
+    return String(userId);
+  };
+
+  const userState = (uid) => {
+    let u = users.get(uid);
+    if (!u) {
+      u = { live: new Map(), clients: new Set() };
+      users.set(uid, u);
+    }
+    return u;
+  };
+
+  /** Forget a user with nothing live and nobody connected, so `users` can't grow without bound. */
+  const prune = (uid) => {
+    const u = users.get(uid);
+    if (u && u.live.size === 0 && u.clients.size === 0) users.delete(uid);
+  };
+
+  // A throwing listener must never take the server down.
+  const emit = (name, payload) => {
+    try { events.emit(name, payload); } catch (err) { logger.error?.(`notify-server: '${name}' listener threw:`, err); }
+  };
+
+  const remaining = (e) => Math.max(1, Math.ceil((e.expiresAt - Date.now()) / 1000));
+  const view = (e) => ({ ...e.n, ttlSeconds: remaining(e) }); // clients get time *left*, not the original TTL
+
+  const send = (ws, msg) => { if (ws.readyState === ws.OPEN) ws.send(JSON.stringify(msg)); };
+  const broadcast = (uid, msg) => { for (const c of users.get(uid)?.clients ?? []) send(c.ws, msg); };
+
+  const hasDesktop = (uid) => {
+    for (const c of users.get(uid)?.clients ?? []) if (c.role === 'desktop') return true;
+    return false;
+  };
+  const broadcastPresence = (uid) => broadcast(uid, { type: 'PRESENCE', desktopConnected: hasDesktop(uid) });
+
+  // ------------------------------------------------------------------ lifecycle
+
+  /**
+   * Publish a notification to one user. A known `id` updates it in place (its original expiry keeps running, so a
+   * refreshed value isn't treated as a brand-new notification); an unknown id creates it.
+   * @returns the notification as stored (including its `id`)
+   */
+  function publish(userId, input) {
+    const uid = normalizeUserId(userId);
+    if (!input || typeof input !== 'object') throw new TypeError('notify-server: notification must be an object');
+    const kind = String(input.kind ?? '');
+    if (!KIND_RE.test(kind)) throw new TypeError('notify-server: notification.kind must match [A-Za-z0-9._:-]{1,64}');
+    const id = input.id !== undefined && input.id !== null ? String(input.id) : `${kind}-${nextId++}`;
+
+    const u = userState(uid);
+    const existing = u.live.get(id);
+    if (existing) {
+      existing.n = { ...existing.n, ...input, id, kind };
+      broadcast(uid, { type: 'UPDATE', notification: view(existing) });
+      return existing.n;
+    }
+
+    if (u.live.size >= maxLivePerUser) throw new Error(`notify-server: user already has ${maxLivePerUser} live notifications`);
+    const ttl = Number.isFinite(input.ttlSeconds) ? Math.min(Math.max(input.ttlSeconds, 1), 3600) : 30;
+    const entry = { n: { ...input, id, kind, createdAt: Date.now() }, expiresAt: Date.now() + ttl * 1000, timer: null };
+    entry.timer = setTimeout(() => resolve(uid, id, 'EXPIRED', null, 'system'), ttl * 1000);
+    u.live.set(id, entry);
+    broadcast(uid, { type: 'NOTIFY', notification: view(entry) });
+    return entry.n;
+  }
+
+  /** First resolution wins; later attempts on the same id are ignored. Returns whether this call resolved it. */
+  function resolve(uid, id, action, payload, by) {
+    const u = users.get(uid);
+    const entry = u?.live.get(id);
+    if (!entry) return false;
+    clearTimeout(entry.timer);
+    u.live.delete(id);
+
+    broadcast(uid, { type: 'RESOLVED', id, kind: entry.n.kind, action, payload: payload ?? null, by });
+    if (action === 'EXPIRED') emit('expired', { userId: uid, id, kind: entry.n.kind, notification: entry.n });
+    else if (by !== 'system') emit('action', { userId: uid, id, kind: entry.n.kind, action, payload: payload ?? null, by, notification: entry.n });
+    prune(uid);
+    return true;
+  }
+
+  /** Withdraw a live notification from every client of that user (e.g. the order was cancelled upstream). */
+  function cancel(userId, id) {
+    return resolve(normalizeUserId(userId), String(id), 'CANCELLED', null, 'system');
+  }
+
+  // ------------------------------------------------------------------ WebSocket
+
+  const wss = new WebSocketServer({ noServer: true, maxPayload });
+
+  const reject = (socket, code, why) => {
+    socket.write(`HTTP/1.1 ${code} ${why}\r\nConnection: close\r\n\r\n`);
+    socket.destroy();
+  };
+
+  /** Browsers always send Origin on a WebSocket upgrade, which is what blocks cross-site hijacking of a cookie login. */
+  const browserOriginOk = (origin, req) => {
+    if (Array.isArray(allowedOrigins)) return allowedOrigins.includes(origin);
+    try { return new URL(origin).host === req.headers.host; } catch { return false; } // default: same origin only
+  };
+
+  async function upgrade(req, socket, head, url) {
+    const role = url.searchParams.get('role');
+    if (!ROLES.has(role)) return reject(socket, 400, 'Bad Request');
+
+    // A missing Origin means a non-browser client, which has no ambient cookies to abuse.
+    const origin = req.headers.origin;
+    if (origin !== undefined) {
+      const ok = role === 'browser' ? browserOriginOk(origin, req) : desktopOrigins.includes(origin);
+      if (!ok) return reject(socket, 403, 'Forbidden');
+    }
+
+    let userId = null;
+    if (role === 'browser') {
+      userId = await authenticate(req); // your function: read the session, ask your SSO, whatever it takes
+    } else {
+      const token = url.searchParams.get('token');
+      userId = tokens?.verify(token) ?? null;
+      if (userId === null && authenticateDesktop) {
+        // `user` is whatever name the overlay says it is. It is UNVERIFIED: it is only ever handed to your own
+        // `authenticateDesktop`, never trusted by this library. Returning it as-is lets anyone who can reach the
+        // server impersonate that user; do that only on a trusted network, and replace it once the overlay has SSO.
+        const claimed = url.searchParams.get('user');
+        const user = claimed && claimed.length <= 128 ? claimed : null;
+        userId = await authenticateDesktop(token, req, { user });
+      }
+    }
+    if (userId === null || userId === undefined || String(userId) === '') return reject(socket, 401, 'Unauthorized');
+    if (socket.destroyed) return; // the client gave up while we were authenticating
+
+    wss.handleUpgrade(req, socket, head, (ws) => onConnection(ws, role, String(userId)));
+  }
+
+  const onUpgrade = (req, socket, head) => {
+    let url;
+    try { url = new URL(req.url ?? '/', 'http://localhost'); } catch { return; }
+    if (url.pathname !== path) return; // not ours: leave it to whatever else listens for upgrades on this server
+    upgrade(req, socket, head, url).catch((err) => {
+      logger.error?.('notify-server: upgrade failed:', err);
+      if (!socket.destroyed) reject(socket, 500, 'Internal Server Error');
+    });
+  };
+  server.on('upgrade', onUpgrade);
+
+  function onConnection(ws, role, uid) {
+    const client = { ws, role, alive: true };
+    const u = userState(uid);
+    u.clients.add(client);
+    emit('connect', { userId: uid, role });
+
+    // Late joiners catch up on whatever is still live for this user.
+    send(ws, { type: 'SNAPSHOT', notifications: [...u.live.values()].map(view) });
+    broadcastPresence(uid);
+
+    ws.on('pong', () => { client.alive = true; });
+
+    ws.on('message', (data) => {
+      let msg;
+      try { msg = JSON.parse(data.toString()); } catch { return; } // malformed input is dropped
+
+      // Text sent from any app by the desktop overlay's global hotkey. Only the desktop role may send it, and the
+      // server builds the notification itself, so a client can't inject arbitrary fields or kinds. Never logged.
+      if (msg?.type === 'CLIPBOARD') {
+        if (role !== 'desktop' || typeof msg.text !== 'string') return;
+        const text = msg.text.trim().slice(0, maxClipboardChars).trimEnd();
+        if (!text) return;
+        publish(uid, {
+          kind: 'clipboard',
+          ttlSeconds: 20,
+          surfaces: ['browser'], // shown in the browser only; the sender's overlay doesn't echo it back
+          data: { title: 'Clipboard from desktop', text },
+        });
+        return;
+      }
+
+      if (msg?.type !== 'ACTION' || typeof msg.id !== 'string') return;
+      if (typeof msg.action !== 'string' || !ACTION_RE.test(msg.action) || msg.action === 'EXPIRED') return;
+      resolve(uid, msg.id, msg.action, msg.payload, role);
+    });
+
+    ws.on('close', () => {
+      u.clients.delete(client);
+      emit('disconnect', { userId: uid, role });
+      broadcastPresence(uid);
+      prune(uid);
+    });
+    ws.on('error', () => ws.terminate());
+  }
+
+  // Drop half-open connections (e.g. a laptop that slept) so presence stays accurate.
+  const heartbeat = setInterval(() => {
+    for (const u of users.values()) {
+      for (const c of u.clients) {
+        if (!c.alive) { c.ws.terminate(); continue; }
+        c.alive = false;
+        c.ws.ping();
+      }
+    }
+  }, heartbeatMs);
+  heartbeat.unref();
+
+  // ------------------------------------------------------------------ public API
+
+  return {
+    publish,
+    cancel,
+
+    /**
+     * Issue a token the desktop overlay uses to log in as `userId`. Call it from an endpoint that has already
+     * authenticated that user (e.g. the web app's "Connect desktop" button). Requires the `secret` option.
+     */
+    createDeviceToken(userId, { ttlSeconds = DEFAULT_DEVICE_TOKEN_TTL_SECONDS } = {}) {
+      if (!tokens) throw new Error('notify-server: set the `secret` option to issue device tokens');
+      if (!(ttlSeconds > 0)) throw new RangeError('notify-server: ttlSeconds must be positive');
+      return tokens.create(normalizeUserId(userId), ttlSeconds);
+    },
+
+    /** @returns the user id a device token belongs to, or null if invalid/expired. Mostly useful in tests. */
+    verifyDeviceToken: (token) => tokens?.verify(token) ?? null,
+
+    liveIds: (userId) => [...(users.get(normalizeUserId(userId))?.live.keys() ?? [])],
+    desktopConnected: (userId) => hasDesktop(normalizeUserId(userId)),
+    stats() {
+      let clients = 0;
+      let live = 0;
+      for (const u of users.values()) { clients += u.clients.size; live += u.live.size; }
+      return { users: users.size, clients, live };
+    },
+
+    /** `action` {userId,id,kind,action,payload,by,notification}, `expired` {...}, `connect`/`disconnect` {userId,role} */
+    on: (name, listener) => events.on(name, listener),
+    off: (name, listener) => events.off(name, listener),
+
+    /** Stop listening, drop every connection, and cancel all timers. */
+    async close() {
+      server.off('upgrade', onUpgrade);
+      clearInterval(heartbeat);
+      for (const u of users.values()) {
+        for (const e of u.live.values()) clearTimeout(e.timer);
+        for (const c of u.clients) c.ws.terminate();
+      }
+      users.clear();
+      await new Promise((r) => wss.close(r));
+    },
+  };
+}
diff --git a/packages/server/src/deviceToken.js b/packages/server/src/deviceToken.js
new file mode 100644
index 0000000000000000000000000000000000000000..dd683b541677e5b3d945410c84be162dd417c4be
--- /dev/null
+++ b/packages/server/src/deviceToken.js
@@ -0,0 +1,48 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+// Device tokens let the desktop overlay log in as a specific user. The overlay is a separate program, so it
+// can't use the web app's session cookie. Your backend issues a token for the logged-in user (see
+// `notify.createDeviceToken`) and the user pastes it into the overlay once.
+//
+// A token is `<payload>.<signature>`: the payload is base64url JSON {u: userId, e: expiry (epoch seconds)} and the
+// signature is HMAC-SHA256(secret, payload). It is stateless, so tokens survive restarts and work across several
+// server instances that share the secret. The flip side: a token can't be revoked individually. Give it a sensible
+// lifetime, and rotate the secret to invalidate every token at once.
+
+const b64 = (buf) => Buffer.from(buf).toString('base64url');
+
+export function createDeviceTokens(secret) {
+  if (typeof secret !== 'string' || secret.length < 16) {
+    throw new Error('notify-server: `secret` must be a string of at least 16 characters');
+  }
+  const sign = (payload) => createHmac('sha256', secret).update(payload).digest();
+
+  return {
+    /** @returns {string} */
+    create(userId, ttlSeconds) {
+      const payload = b64(JSON.stringify({ u: String(userId), e: Math.floor(Date.now() / 1000) + ttlSeconds }));
+      return `${payload}.${b64(sign(payload))}`;
+    },
+
+    /** @returns {string | null} the user id, or null if the token is malformed, tampered with, or expired */
+    verify(token) {
+      if (typeof token !== 'string') return null;
+      const parts = token.split('.');
+      if (parts.length !== 2) return null;
+      const [payload, signature] = parts;
+
+      const expected = sign(payload);
+      let given;
+      try { given = Buffer.from(signature, 'base64url'); } catch { return null; }
+      if (given.length !== expected.length || !timingSafeEqual(given, expected)) return null;
+
+      try {
+        const { u, e } = JSON.parse(Buffer.from(payload, 'base64url').toString());
+        if (typeof u !== 'string' || !u || typeof e !== 'number') return null;
+        return e > Math.floor(Date.now() / 1000) ? u : null;
+      } catch {
+        return null;
+      }
+    },
+  };
+}
diff --git a/packages/server/test/notify-server.test.js b/packages/server/test/notify-server.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..04a1ad1fd6f230db43e8cad4fd95aa0cf78e3d8b
--- /dev/null
+++ b/packages/server/test/notify-server.test.js
@@ -0,0 +1,454 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { WebSocket, WebSocketServer } from 'ws';
+// NOTIFY_ENTRY (a file:// URL) lets the same tests run against the bundled single-file drop-in (tools/dropin/verify.mjs).
+const { createNotifyServer } = await import(process.env.NOTIFY_ENTRY ?? '../index.js');
+
+const SECRET = 'test-secret-test-secret';
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+const quiet = { error() {} };
+
+/** A real HTTP server + notify server on an ephemeral port. `authenticate` reads an `x-user` header. */
+async function start(options = {}) {
+  const server = http.createServer((req, res) => res.end('ok'));
+  const notify = createNotifyServer({
+    server,
+    path: '/notify',
+    authenticate: (req) => req.headers['x-user'] ?? null,
+    secret: SECRET,
+    logger: quiet,
+    ...options,
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  const port = server.address().port;
+  const clients = [];
+
+  return {
+    notify,
+    server,
+    port,
+    /** Resolves with the open client; rejects with {status} if the server refuses the upgrade. */
+    connect(role, { user, token, claimedUser, origin, path = '/notify' } = {}) {
+      return new Promise((resolve, reject) => {
+        const q = new URLSearchParams({ role });
+        if (token) q.set('token', token);
+        if (claimedUser) q.set('user', claimedUser); // the overlay's unverified "I am <name>"
+        const ws = new WebSocket(`ws://127.0.0.1:${port}${path}?${q}`, {
+          headers: user ? { 'x-user': user } : {},
+          origin,
+        });
+        const c = { ws, msgs: [], of: (type) => c.msgs.filter((m) => m.type === type) };
+        ws.on('message', (d) => c.msgs.push(JSON.parse(d.toString())));
+        ws.on('open', () => { clients.push(c); resolve(c); });
+        ws.on('unexpected-response', (req, res) => {
+          req.destroy();
+          reject(Object.assign(new Error(`HTTP ${res.statusCode}`), { status: res.statusCode }));
+        });
+        ws.on('error', () => {}); // surfaced through unexpected-response
+      });
+    },
+    send: (c, msg) => c.ws.send(JSON.stringify(msg)),
+    async stop() {
+      clients.forEach((c) => c.ws.terminate());
+      await notify.close();
+      await new Promise((r) => server.close(r));
+    },
+  };
+}
+
+const refused = (promise) => promise.then(() => assert.fail('connection should have been refused'), (e) => e.status);
+
+test('refuses a browser connection that has no identity (401)', async () => {
+  const h = await start();
+  try {
+    assert.equal(await refused(h.connect('browser')), 401);
+  } finally { await h.stop(); }
+});
+
+test('accepts an async authenticate, and refuses one that throws (500)', async () => {
+  const ok = await start({ authenticate: async (req) => { await wait(20); return req.headers['x-user'] ?? null; } });
+  try {
+    const c = await ok.connect('browser', { user: 'alice' });
+    assert.ok(c.ws.readyState === WebSocket.OPEN);
+  } finally { await ok.stop(); }
+
+  const bad = await start({ authenticate: () => { throw new Error('sso down'); } });
+  try {
+    assert.equal(await refused(bad.connect('browser', { user: 'alice' })), 500);
+  } finally { await bad.stop(); }
+});
+
+test('browser Origin: same-origin allowed, cross-site refused (blocks hijacking a cookie login)', async () => {
+  const h = await start();
+  try {
+    assert.equal(await refused(h.connect('browser', { user: 'a', origin: 'http://evil.example' })), 403);
+    const ok = await h.connect('browser', { user: 'a', origin: `http://127.0.0.1:${h.port}` });
+    assert.ok(ok.ws.readyState === WebSocket.OPEN);
+  } finally { await h.stop(); }
+});
+
+test('allowedOrigins overrides the same-origin default', async () => {
+  const h = await start({ allowedOrigins: ['http://localhost:5173'] });
+  try {
+    const ok = await h.connect('browser', { user: 'a', origin: 'http://localhost:5173' });
+    assert.ok(ok.ws.readyState === WebSocket.OPEN);
